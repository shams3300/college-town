  castShadow: true
  feetPosition: {x: 8.15, y: {terrain: 0.15}, z: 3.35}
  id: review-backview
  material: {alphaTest: 0.5, roughness: 1, side: double}
  primitive: {kind: scripted, params: {mask: {samples: /cdn/value.7fe210738f5f3e5635d06024e9b587ae3c59a45ba81a95a4e3ca96b1844c3e47.png}, rev: 2, texture: /cdn/value.6f4134a9f3b20ed9019546b56955b227ab3b8b62f95130feb69e2fc9d9aa8363.png}, script: scripts/rig2d.js}
